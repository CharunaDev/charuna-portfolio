# Supabase Transaction pooler connection string, used by the running app.
# Dashboard -> Project Settings -> Database -> Connection string -> Transaction pooler
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase direct connection string, used only by Prisma Migrate.
# Dashboard -> Project Settings -> Database -> Connection string -> Direct connection
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"
